---
/**
 * 「为 TA 充电」的电池图形（移植自旧博客的 #tube-con）。
 *
 * 同一份路径用三遍：灰色底、粉色电量（宽度从 0 长满）、黄色电火花（横向扫过）。
 * 描边和填充都用 currentColor，由外层类名控制颜色，省得写三份色值。
 */
const TUBE_PATHS = [
  'M1 77H234.226L307.006 24H790',
  'M0 140H233.035L329.72 71H1028',
  'M1 255H234.226L307.006 307H790',
  'M0 305H233.035L329.72 375H1028',
];
---

<svg viewBox="0 0 1028 385" fill="none" aria-hidden="true" focusable="false">
  {
    TUBE_PATHS.map((d) => (
      <path d={d} stroke="currentColor" stroke-width="20"></path>
    ))
  }
  <rect y="186" width="236" height="24" fill="currentColor"></rect>
  <ellipse cx="790" cy="25.5" rx="25" ry="25.5" fill="currentColor"></ellipse>
  <circle r="14" cx="790" cy="25" fill="#fff"></circle>
  <ellipse cx="790" cy="307.5" rx="25" ry="25.5" fill="currentColor"></ellipse>
  <circle r="14" cx="790" cy="308" fill="#fff"></circle>
</svg>
