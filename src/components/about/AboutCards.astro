---
import { siteConfig } from '@constants/site-config';
/**
 * 关于页卡片墙 —— 形态参照 anheyu 官方关于页（https://blog.anheyu.com/about）。
 *
 * 版式实测自该页：容器 1352px、卡片圆角 12px、内边距 16px 32px；
 * 行内配比 59%+39% / 49%+49% / 100%，用 24 列网格表达为 14+10、12+12、24。
 *
 * 内容全部来自 ./about-config.ts，改内容不用动本文件。
 *
 * 交互三处（均无外部依赖）：
 *   1. Hello there! 色块随鼠标在字母笔画里游走（SVG mask）。
 *   2. 追求卡片文案轮换。
 *   3. 访问人数用 busuanzi（vercount）实时取。
 */
import { Icon } from 'astro-icon/components';
import {
  buff,
  careers,
  comic,
  game,
  hello,
  location,
  maxim,
  personality,
  photo,
  profile,
  pursuit,
  SKILL_ICON_BASE,
  selfInfo,
  skills,
  tenyear,
} from './about-config';

// 访问统计必须上报线上站点地址：本地/预览域名会被 busuanzi 视作未知站点并返回
// 全局累计值（实测 4900 万量级，严重失真）。
const siteUrl = (siteConfig.site || '').replace(/\/+$/, '');

// 技能轮播：列表复制一份，轨道平移到 -50% 时正好回到起点，形成无缝循环
// （与旧博客 #skills-tags-group-all 同一手法）。
const skillLoop = [...skills.list, ...skills.list];

/**
 * 十年之约的日期格式化。
 *
 * 渲染阶段就把日期定成 `Y/M/D` 并写进 `data-date`，脚本读这个属性而不是显示文本
 * ——否则 `new Date('2025/7/18')` 在部分系统语言下会被解析成 M/D/YYYY。
 * （这是移植方案 8-25 修正版的核心改动。）
 */
function formatTenYearDate(value: string): string {
  const [year, month, day] = value.split('/').map((part) => Number.parseInt(part, 10));
  if (!Number.isFinite(year) || !Number.isFinite(month) || !Number.isFinite(day)) return value;
  return `${year}/${month}/${day}`;
}

const tenyearStart = formatTenYearDate(tenyear.start);
const tenyearEnd = formatTenYearDate(tenyear.end);
---

<div class="ab" data-site-url={siteUrl}>
  <!-- 作者头部：头像居中，标签左右各 4 个，下方页面大标题 --------------- -->
  <header class="ab-hero ab-span-24">
    <div class="ab-hero-row">
      <div class="ab-hero-tags ab-hero-tags--left">
        {profile.tagsLeft.map((tag) => <span class="ab-tag">{tag}</span>)}
      </div>
      <img class="ab-hero-avatar" src={profile.avatar} alt="头像" loading="lazy" />
      <div class="ab-hero-tags ab-hero-tags--right">
        {profile.tagsRight.map((tag) => <span class="ab-tag">{tag}</span>)}
      </div>
    </div>
    <h1 class="ab-hero-title">{profile.heading}</h1>
  </header>

  <!-- 第一排：自我介绍 59% + 追求 39% -------------------------------- -->
  <section class="ab-card ab-span-14 ab-hello">
    <p class="ab-hello-greeting">{hello.greeting}</p>
    <p class="ab-hello-name">
      我叫 <span class="ab-hello-word">{hello.name}</span>
    </p>
    <p class="ab-hello-sub">{hello.subtitle}</p>
  </section>

  <section class="ab-card ab-span-10 ab-pursuit">
    <p class="ab-tips">{pursuit.tips}</p>
    <h2 class="ab-pursuit-title">
      {pursuit.line1}
      <br />
      {pursuit.line2}
      <span class="ab-pursuit-mask" data-pursuit-words>
        {pursuit.words.map((word) => <span class="ab-pursuit-word" style={`color:${word.color}`}>{word.text}</span>)}
      </span>
    </h2>
  </section>

  <!-- Hello there!：色块在字母笔画里游走（SVG mask）------------------- -->
  <section class="ab-card ab-span-24 ab-hello-big" data-hello-card>
    <svg class="ab-hello-svg" viewBox="0 0 1000 200" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <defs>
        <mask id="ab-hello-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1000" height="200">
          <rect x="0" y="0" width="1000" height="200" fill="#000" />
          <text
            x="500"
            y="100"
            text-anchor="middle"
            dominant-baseline="central"
            font-size="150"
            font-weight="800"
            fill="#fff">Hello there!</text>
        </mask>
      </defs>
      <g mask="url(#ab-hello-mask)">
        <rect x="0" y="0" width="1000" height="200" fill="var(--ab-hello-base)" />
        <circle class="ab-blob ab-blob-1" r="110" cx="500" cy="100" />
        <circle class="ab-blob ab-blob-2" r="80" cx="500" cy="100" />
        <circle class="ab-blob ab-blob-3" r="52" cx="500" cy="100" />
        <circle class="ab-blob-cursor" r="22" cx="500" cy="100" />
      </g>
    </svg>
  </section>

  <!-- 第二排：技能 49% + 生涯 49% ------------------------------------ -->
  <section class="ab-card ab-span-12 ab-skills">
    <p class="ab-tips">{skills.tips}</p>
    <h2 class="ab-title">{skills.title}</h2>
    <!--
      默认：单行无限轮播（轨道内容复制一份，平移到 -50% 即无缝循环）。
      每对里的第二个方块下移 + 左移，形成安知鱼那种斜向交错；
      悬停时整块切换成"全部技能"面板，显示的是技能图片本身。
    -->
    <div class="ab-skill-marquee">
      <div class="ab-skill-track">
        {
          skillLoop.map((skill, index) => (
            <span class={`ab-tile${index % 2 === 1 ? ' ab-tile--odd' : ''}`} style={`background:${skill.color}`} title={skill.name}>
              <img src={`${SKILL_ICON_BASE}/${skill.icon}.svg`} alt={skill.name} loading="lazy" />
            </span>
          ))
        }
      </div>
    </div>
    <!-- 悬停时显示：全部技能平铺 -->
    <div class="ab-skill-all">
      {
        skills.list.map((skill) => (
          <span class="ab-tile" style={`background:${skill.color}`} title={skill.name}>
            <img src={`${SKILL_ICON_BASE}/${skill.icon}.svg`} alt={skill.name} loading="lazy" />
          </span>
        ))
      }
    </div>
  </section>

  <section class="ab-card ab-span-12 ab-careers">
    <p class="ab-tips">{careers.tips}</p>
    <h2 class="ab-title">{careers.title}</h2>
    <p class="ab-career-edu">EDU</p>
    <p class="ab-career-desc">{careers.desc}</p>
    {
      careers.image ? (
        <img class="ab-career-img" src={careers.image} alt="" loading="lazy" />
      ) : (
        <div class="ab-career-img ab-career-img--empty" aria-hidden="true">
          <span>在 about-config.ts 的 careers.image 填入你的图片</span>
        </div>
      )
    }
  </section>

  <!-- 第三排：访问统计 39% + 右侧（地图 + 个人信息）59% ---------------- -->
  <section class="ab-card ab-span-10 ab-statistic">
    <p class="ab-tips">数据</p>
    <h2 class="ab-title">访问统计</h2>
    <!--
      六项来自 51LA 数据挂件脚本（真实数据内嵌在 quote.js 的脚本文本里，
      见 PostCharts.astro 里的同源解析脚本；这里只放占位与 data-stat 标识）。
      原先的三项（访问人数/总访问量/本页阅读）来自 busuanzi，实测虚高
      （UV > PV，且比 51LA 高两个数量级），已换成 51LA 口径。
    -->
    <div class="ab-stat-grid">
      <div class="ab-stat">
        <span class="ab-stat-label">今日人数</span>
        <span class="ab-stat-value" data-stat="todayUv">—</span>
      </div>
      <div class="ab-stat">
        <span class="ab-stat-label">今日访问</span>
        <span class="ab-stat-value" data-stat="todayPv">—</span>
      </div>
      <div class="ab-stat">
        <span class="ab-stat-label">昨日人数</span>
        <span class="ab-stat-value" data-stat="yesterdayUv">—</span>
      </div>
      <div class="ab-stat">
        <span class="ab-stat-label">昨日访问</span>
        <span class="ab-stat-value" data-stat="yesterdayPv">—</span>
      </div>
      <div class="ab-stat">
        <span class="ab-stat-label">本月访问</span>
        <span class="ab-stat-value" data-stat="monthPv">—</span>
      </div>
      <div class="ab-stat">
        <span class="ab-stat-label">总访问量</span>
        <span class="ab-stat-value" data-stat="totalPv">—</span>
      </div>
    </div>
    <p class="ab-stat-source">
      <Icon name="ri:shield-check-line" />
      <span>数据来自 51LA</span>
    </p>
    <a class="ab-button" href="/archives">
      <Icon name="ri:arrow-right-circle-line" />
      <span>文章统计</span>
    </a>
  </section>

  <div class="ab-stack ab-span-14">
    <section class="ab-card ab-map">
      {
        location.image ? (
          <img class="ab-map-img" src={location.image} alt="" loading="lazy" />
        ) : (
          <div class="ab-map-img ab-map-img--empty" aria-hidden="true">
            <Icon name="ri:image-add-line" />
            <span>在 about-config.ts 的 location.image 填入你的图片</span>
          </div>
        )
      }
      <p class="ab-map-caption">
        {location.tips} <strong>{location.label}</strong>
      </p>
    </section>

    <section class="ab-card ab-self">
      {
        selfInfo.map((item) => (
          <div class="ab-self-col">
            <span class="ab-self-tips">{item.tips}</span>
            <span class="ab-self-content">{item.content}</span>
          </div>
        ))
      }
    </section>
  </div>

  <!-- 第四排：性格 59% + 照片 39% ------------------------------------ -->
  <section class="ab-card ab-span-14 ab-personality">
    <p class="ab-tips">{personality.tips}</p>
    <div class="ab-personality-body">
      <div class="ab-personality-text">
        <h2 class="ab-personality-name">{personality.name}</h2>
        <p class="ab-personality-type">{personality.type}</p>
      </div>
      <img class="ab-personality-img" src={personality.image} alt={personality.type} loading="lazy" />
    </div>
    <a class="ab-personality-link" href={personality.link} target="_blank" rel="noopener noreferrer">
      在 16personalities 了解更多关于 {personality.name}
    </a>
  </section>

  <section class="ab-card ab-span-10 ab-photo">
    <img src={photo} alt="照片" loading="lazy" />
  </section>

  <!-- 第五排：座右铭 39% + 特长 59% ---------------------------------- -->
  <section class="ab-card ab-span-10 ab-quote">
    <p class="ab-tips">{maxim.tips}</p>
    <h2 class="ab-quote-line">{maxim.line1}</h2>
    <h2 class="ab-quote-line">{maxim.line2}</h2>
  </section>

  <section class="ab-card ab-span-14 ab-buff">
    <p class="ab-tips">{buff.tips}</p>
    <h2 class="ab-quote-line">{buff.line1}</h2>
    <h2 class="ab-quote-line">{buff.line2}</h2>
    <Icon name="ri:gamepad-fill" class="ab-buff-icon" />
  </section>

  <!-- 爱好的游戏 39%（单张图片）+ 在追小说 59% ------------------------- -->
  <section class="ab-card ab-span-14 ab-game">
    <div class="ab-comic-head">
      <p class="ab-tips">{game.tips}</p>
      <h2 class="ab-title ab-title-lg">{game.title}</h2>
    </div>
    {
      game.image ? (
        <img class="ab-game-img" src={game.image} alt={game.title} loading="lazy" />
      ) : (
        <div class="ab-game-img ab-game-img--empty" aria-hidden="true">
          <Icon name="ri:image-add-line" />
          <span>在 about-config.ts 的 game.image 填入你的图片</span>
        </div>
      )
    }
  </section>

  <!-- 在追的小说：斜切封面条，悬停展开（旧博客 .comic-content 卡片）------ -->
  <section class="ab-card ab-span-10 ab-comic">
    <div class="ab-comic-head">
      <p class="ab-tips">{comic.tips}</p>
      <h2 class="ab-title ab-title-lg">{comic.title}</h2>
      {comic.date && <p class="ab-comic-date">{comic.date}</p>}
    </div>
    <div class="ab-comic-box">
      {
        comic.list.map((item, index) => (
          <a class="ab-comic-item" href={item.href || '#'} target="_blank" rel="noopener noreferrer" title={item.name}>
            <span class="ab-comic-cover" data-tone={index % 4}>
              {item.cover ? (
                <img src={item.cover} alt={item.name} loading="lazy" />
              ) : (
                <span class="ab-comic-empty">
                  <span class="ab-comic-spine" />
                  <span class="ab-comic-name">{item.name}</span>
                </span>
              )}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 十年之约：进度条（移植自 blog.gbfun.cc/posts/5498433.html）-------- -->
  <section class="ab-card ab-span-24 ab-tenyear">
    <p class="ab-tips">{tenyear.tips}</p>
    <h2 class="ab-title ab-title-lg">{tenyear.title}</h2>
    <div class="ab-tenyear-timeline">
      <span class="ab-tenyear-progress" />
      <span class="ab-tenyear-past" />
      <span class="ab-tenyear-label" data-tenyear-label />
    </div>
    <div class="ab-tenyear-times">
      <span data-tenyear-start data-date={tenyearStart}>{tenyearStart}</span>
      <span data-tenyear-end data-date={tenyearEnd}>{tenyearEnd}</span>
    </div>
  </section>
</div>

<script>
  import { initLa51Stats } from '@lib/la51-stats';

  /**
   * Hello there!：色块随鼠标在字母笔画里游走。
   *
   * 可视范围由 SVG mask（白色文字）决定，色块只在该 mask 内可见，因此视觉上
   * 像色块从字母里穿过去。位移用 viewBox(1000x200) 坐标，故与元素像素尺寸无关。
   */
  function initHelloBig() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    for (const card of document.querySelectorAll<HTMLElement>('[data-hello-card]')) {
      if (card.dataset.helloBound === 'true') continue;
      card.dataset.helloBound = 'true';

      const blobs = [...card.querySelectorAll<SVGCircleElement>('.ab-blob, .ab-blob-cursor')];
      if (blobs.length === 0) continue;

      const factors = [1, 0.72, 0.5, 1.25];
      const posX = blobs.map(() => 0);
      const posY = blobs.map(() => 0);
      let targetX = 0;
      let targetY = 0;

      const tick = () => {
        blobs.forEach((blob, i) => {
          const factor = factors[i] ?? 1;
          posX[i] += (targetX * factor - posX[i]) * 0.12;
          posY[i] += (targetY * factor - posY[i]) * 0.12;
          blob.setAttribute('transform', `translate(${posX[i].toFixed(2)} ${posY[i].toFixed(2)})`);
        });
        requestAnimationFrame(tick);
      };

      card.addEventListener('mousemove', (event: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        const nx = (event.clientX - rect.left - rect.width / 2) / Math.max(rect.width / 2, 1);
        const ny = (event.clientY - rect.top - rect.height / 2) / Math.max(rect.height / 2, 1);
        targetX = Math.max(-1, Math.min(1, nx)) * 330;
        targetY = Math.max(-1, Math.min(1, ny)) * 55;
      });

      requestAnimationFrame(tick);
    }
  }

  /** 追求卡片文案轮换。 */
  function initPursuit() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    for (const mask of document.querySelectorAll<HTMLElement>('[data-pursuit-words]')) {
      if (mask.dataset.pursuitBound === 'true') continue;
      mask.dataset.pursuitBound = 'true';

      const words = [...mask.querySelectorAll<HTMLElement>('.ab-pursuit-word')];
      if (words.length < 2) continue;
      let index = 0;
      const apply = () => {
        words.forEach((word, i) => {
          word.classList.toggle('is-current', i === index);
          word.classList.toggle('is-previous', i === (index - 1 + words.length) % words.length);
        });
      };
      apply();
      setInterval(() => {
        index = (index + 1) % words.length;
        apply();
      }, 2000);
    }
  }

  /**
   * 十年之约进度条。
   *
   * 按移植方案（blog.gbfun.cc/posts/5498433.html）实现：进度 = 已过时间 / 总时长，
   * 用 CSS 变量驱动宽度，靠 keyframes 做入场动画；百分比标签跟随进度横向移动。
   * 日期从 `data-date` 读，避免系统语言影响 `new Date(文本)` 的解析。
   */
  function initTenYearProgress() {
    const root = document.querySelector<HTMLElement>('.ab-tenyear');
    if (!root) return;

    const progressEl = root.querySelector<HTMLElement>('.ab-tenyear-progress');
    const pastEl = root.querySelector<HTMLElement>('.ab-tenyear-past');
    const labelEl = root.querySelector<HTMLElement>('[data-tenyear-label]');
    const startEl = root.querySelector<HTMLElement>('[data-tenyear-start]');
    const endEl = root.querySelector<HTMLElement>('[data-tenyear-end]');
    if (!progressEl || !pastEl || !labelEl || !startEl || !endEl) return;

    const start = new Date(startEl.dataset.date ?? startEl.textContent ?? '').getTime();
    const end = new Date(endEl.dataset.date ?? endEl.textContent ?? '').getTime();
    if (!Number.isFinite(start) || !Number.isFinite(end) || end <= start) return;

    const progress = ((Date.now() - start) / (end - start)) * 100;
    const clamped = Math.max(0, Math.min(progress, 100));

    pastEl.style.setProperty('--ab-past', `${clamped}%`);
    progressEl.style.setProperty('--ab-progress', `${clamped}%`);

    if (progress > 5) {
      labelEl.textContent = `${progress.toFixed(0)}%`;
      labelEl.style.left = `calc(${clamped}% - 35px)`;
    }
    labelEl.style.visibility = 'visible';
  }

  function initAbout() {
    initHelloBig();
    initPursuit();
    initTenYearProgress();
    initLa51Stats();
  }

  initAbout();
  document.addEventListener('astro:page-load', initAbout);
</script>