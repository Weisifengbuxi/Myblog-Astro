---
import { getAlbum, getAlbumItems } from '@lib/pages';
/**
 * Album detail — grouped photo gallery for one album id.
 *
 * Photos are grouped per album entry ("记录") so that a record's images stay
 * together, and clicking a photo opens a lightweight in-page lightbox (no
 * third-party dependency, matching how the rest of the theme behaves).
 */
import { Icon } from 'astro-icon/components';

interface Props {
  id: string;
}

const { id } = Astro.props;
const album = getAlbum(id);
const items = getAlbumItems(id);

if (!album) {
  throw new Error(`Unknown album id "${id}" — check config/pages.yaml`);
}

// Flat list so the lightbox can page through every photo in the album.
const allPhotos = items.flatMap((item) => item.images.map((src) => ({ src, caption: item.content, date: item.date })));

const formattedDate = (value: string) => {
  const d = new Date(value.length <= 10 ? `${value}T00:00:00` : value);
  return Number.isNaN(d.getTime()) ? value : d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<div
  class="album-detail"
  data-album={id}
  data-photos={JSON.stringify(allPhotos.map((p) => ({ src: p.src, caption: p.caption })))}
>
  <p class="album-intro">{album.description}</p>

  {
    items.length === 0 ? (
      <p class="album-empty">这个相册还没有照片。</p>
    ) : (
      items.map((item) => (
        <section class="album-record">
          <header class="album-record-head">
            <h2 class="album-record-content">{item.content}</h2>
            <div class="album-record-meta">
              <span>{formattedDate(item.date)}</span>
              {item.address && <span>· {item.address}</span>}
              {item.from && <span>· 摄影：{item.from}</span>}
            </div>
          </header>
          <div class="album-grid">
            {item.images.map((src, index) => (
              <button
                type="button"
                class="album-photo"
                data-index={allPhotos.findIndex((p) => p.src === src && p.caption === item.content)}
                aria-label={`查看第 ${index + 1} 张照片`}
              >
                <img src={src} alt={item.content} loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        </section>
      ))
    )
  }

  <div class="album-lightbox" hidden>
    <button type="button" class="album-lb-close" aria-label="关闭">
      <Icon name="ri:close-line" />
    </button>
    <button type="button" class="album-lb-prev" aria-label="上一张">
      <Icon name="ri:arrow-left-s-line" />
    </button>
    <figure class="album-lb-figure">
      <img class="album-lb-img" src="" alt="" />
      <figcaption class="album-lb-caption"></figcaption>
    </figure>
    <button type="button" class="album-lb-next" aria-label="下一张">
      <Icon name="ri:arrow-right-s-line" />
    </button>
  </div>
</div>

<script>
  // Lightbox: click a photo to open, arrows / Esc to navigate, click backdrop to close.
  document.querySelectorAll<HTMLElement>('.album-detail').forEach((root) => {
    const raw = root.dataset.photos;
    if (!raw) return;
    let photos: { src: string; caption: string }[] = [];
    try {
      photos = JSON.parse(raw);
    } catch {
      return;
    }
    if (!photos.length) return;

    const box = root.querySelector<HTMLElement>('.album-lightbox');
    const img = root.querySelector<HTMLImageElement>('.album-lb-img');
    const caption = root.querySelector<HTMLElement>('.album-lb-caption');
    if (!box || !img || !caption) return;

    let index = 0;

    const render = () => {
      const photo = photos[index];
      if (!photo) return;
      img.src = photo.src;
      img.alt = photo.caption;
      caption.textContent = `${index + 1} / ${photos.length} · ${photo.caption}`;
    };

    const open = (i: number) => {
      index = (i + photos.length) % photos.length;
      render();
      box.hidden = false;
      document.documentElement.style.overflow = 'hidden';
    };

    const close = () => {
      box.hidden = true;
      document.documentElement.style.overflow = '';
    };

    root.querySelectorAll<HTMLElement>('.album-photo').forEach((btn) => {
      btn.addEventListener('click', () => open(Number(btn.dataset.index ?? 0)));
    });
    box.querySelector('.album-lb-close')?.addEventListener('click', close);
    box.addEventListener('click', (event) => {
      if (event.target === box) close();
    });
    root.querySelector('.album-lb-prev')?.addEventListener('click', (event) => {
      event.stopPropagation();
      open(index - 1);
    });
    root.querySelector('.album-lb-next')?.addEventListener('click', (event) => {
      event.stopPropagation();
      open(index + 1);
    });

    const onKey = (event: KeyboardEvent) => {
      if (box.hidden) return;
      if (event.key === 'Escape') close();
      if (event.key === 'ArrowLeft') open(index - 1);
      if (event.key === 'ArrowRight') open(index + 1);
    };
    document.addEventListener('keydown', onKey);
    // Re-registering on view transitions would double-bind; the handler is
    // idempotent because it only acts while the lightbox is open.
  });
</script>

<style>
  .album-intro {
    opacity: 0.8;
  }

  .album-empty {
    text-align: center;
    opacity: 0.6;
    padding: 2rem 0;
  }

  .album-record + .album-record {
    margin-top: 2rem;
  }

  .album-record-head {
    margin-bottom: 0.75rem;
  }

  .album-record-content {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0;
  }

  .album-record-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.8rem;
    opacity: 0.6;
    margin-top: 0.2rem;
  }

  .album-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    gap: 0.6rem;
  }

  .album-photo {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: 0.5rem;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .album-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
    transition: transform 0.35s ease;
  }

  .album-photo:hover img {
    transform: scale(1.05);
  }

  .album-lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: rgb(0 0 0 / 0.82);
    backdrop-filter: blur(4px);
    padding: 1rem;
  }

  .album-lightbox[hidden] {
    display: none;
  }

  .album-lb-figure {
    margin: 0;
    max-width: min(90vw, 70rem);
    max-height: 86vh;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .album-lb-img {
    max-width: 100%;
    max-height: 78vh;
    object-fit: contain;
    margin: 0;
    border-radius: 0.4rem;
  }

  .album-lb-caption {
    color: rgb(255 255 255 / 0.85);
    font-size: 0.85rem;
    text-align: center;
  }

  .album-lb-close,
  .album-lb-prev,
  .album-lb-next {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    cursor: pointer;
    color: #fff;
    background: rgb(255 255 255 / 0.12);
    border-radius: 9999px;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.5rem;
    transition: background 0.2s ease;
    flex: 0 0 auto;
  }

  .album-lb-close:hover,
  .album-lb-prev:hover,
  .album-lb-next:hover {
    background: rgb(255 255 255 / 0.24);
  }

  .album-lb-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  @media (max-width: 640px) {
    .album-lb-prev,
    .album-lb-next {
      position: absolute;
      bottom: 1.25rem;
    }

    .album-lb-prev {
      left: 1.25rem;
    }

    .album-lb-next {
      right: 1.25rem;
    }
  }
</style>
