---
/**
 * 网站统计 — post / tag / category distributions.
 *
 * Replaces the Hexo page that loaded ECharts from a CDN (echarts 4.9.0-rc, ~700KB)
 * just to draw three bar charts. These are rendered as CSS bars at build time:
 * no client JS, no third-party dependency, and they inherit the theme's colours
 * and dark mode automatically.
 */
import { siteConfig } from '@constants/site-config';
import { getSortedPosts } from '@lib/content';
import { getSiteStats } from '@lib/stats';
import { defaultLocale } from '@/i18n';

interface Props {
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;
const posts = await getSortedPosts(locale);
// 全站字数 / 阅读时长 / 文章数，与页脚同源，避免两处算各一套。
const siteStats = await getSiteStats();

// ---- posts per month -------------------------------------------------------
const monthCounts = new Map<string, number>();
for (const post of posts) {
  const d = new Date(post.data.date);
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  monthCounts.set(key, (monthCounts.get(key) ?? 0) + 1);
}
const monthSeries = [...monthCounts.entries()].sort(([a], [b]) => a.localeCompare(b));
const maxMonth = Math.max(1, ...monthSeries.map(([, n]) => n));
const monthTotal = posts.length;

// ---- tag distribution ------------------------------------------------------
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const topTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 12);
const maxTag = Math.max(1, ...topTags.map(([, n]) => n));

// ---- category distribution -------------------------------------------------
// `categories` is either string[] or string[][]; a chain like
// [['学习笔记','代码学习']] is shown as "学习笔记 / 代码学习".
const categoryCounts = new Map<string, number>();
for (const post of posts) {
  const raw = post.data.categories;
  if (!raw?.length) continue;
  const first = raw[0];
  const label = Array.isArray(first) ? first.join(' / ') : String(first);
  if (label) categoryCounts.set(label, (categoryCounts.get(label) ?? 0) + 1);
}
const categorySeries = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
const maxCategory = Math.max(1, ...categorySeries.map(([, n]) => n));

// ---- site runtime ----------------------------------------------------------
// `startYear` 可能是年份（2025）也可能是完整日期（2025/7/14，注意不是 ISO 格式，
// `new Date()` 在 Safari 上会解析失败），所以按 `/`、`-` 分隔手动解析。
function parseStartDate(value: number | string | undefined): Date | null {
  if (value === undefined || value === null) return null;
  const parts = String(value)
    .split(/[/\-.]/)
    .map((part) => Number.parseInt(part, 10));
  if (parts.some((part) => !Number.isFinite(part))) return null;

  const [first, second, third] = parts;
  // 年份在前（2025/7/14）或年份在后（7/14/2025）都支持。
  if (first >= 1000) return new Date(first, (second ?? 1) - 1, third ?? 1);
  if (third !== undefined && third >= 1000) return new Date(third, first - 1, second ?? 1);
  return null;
}

const startDate = parseStartDate(siteConfig.startDate);
const runningDays = startDate ? Math.max(1, Math.ceil((Date.now() - startDate.getTime()) / 86_400_000)) : '—';

// ---- last update -----------------------------------------------------------
// 文章按时间倒序返回，取第一篇的日期即最后一次更新。
const lastUpdated = posts.length
  ? new Date(posts[0].data.updated ?? posts[0].data.date).toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    })
  : '—';

// ---- site totals + last update --------------------------------------------
const summary = [
  { label: '文章总数', value: posts.length },
  { label: '标签总数', value: tagCounts.size },
  { label: '分类总数', value: categoryCounts.size },
  { label: '有记录月份', value: monthSeries.length },
  { label: '总字数', value: siteStats.formattedWords },
  { label: '总阅读时长', value: siteStats.formattedTime },
  { label: '运行天数', value: runningDays },
];
---

<div class="charts">
  <section class="charts-block">
    <h2 class="charts-title">网站资讯</h2>

    <!--
      访问数据：数值来自 busuanzi（vercount，真实值），
      今日/昨日/本月/全站的口径由本地累计得到 —— busuanzi 只给"累计 UV/PV"两个数，
      没有日/月维度，而 51LA 的公开数据挂件只输出占位符（其脚本内不含取数逻辑，
      实测渲染出的是写死的 0/3/9/2…），拿不到真实数据，因此不再使用它。
      副作用：日/月数据从本功能上线起开始累计，不是历史回填。
    -->
    <div class="charts-summary">
      <div class="charts-stat">
        <span class="charts-stat-value" data-site-stat="todayUv">—</span>
        <span class="charts-stat-label">今日人数</span>
      </div>
      <div class="charts-stat">
        <span class="charts-stat-value" data-site-stat="todayPv">—</span>
        <span class="charts-stat-label">今日访问</span>
      </div>
      <div class="charts-stat">
        <span class="charts-stat-value" data-site-stat="yesterdayUv">—</span>
        <span class="charts-stat-label">昨日人数</span>
      </div>
      <div class="charts-stat">
        <span class="charts-stat-value" data-site-stat="yesterdayPv">—</span>
        <span class="charts-stat-label">昨日访问</span>
      </div>
      <div class="charts-stat">
        <span class="charts-stat-value" data-site-stat="monthPv">—</span>
        <span class="charts-stat-label">本月访问</span>
      </div>
      <div class="charts-stat">
        <span class="charts-stat-value" data-site-stat="totalPv">—</span>
        <span class="charts-stat-label">总访问量</span>
      </div>
    </div>

    <div class="charts-totals">
      {
        summary.map((item) => (
          <div class="charts-total">
            <span class="charts-total-label">{item.label}</span>
            <span class="charts-total-value">{item.value}</span>
          </div>
        ))
      }
    </div>
    <p class="charts-source">
      访问数据来自 51LA 数据挂件，兜底为 busuanzi；其余为构建时统计 · 最后更新 {lastUpdated}
    </p>
  </section>

  <section class="charts-block">
    <h2 class="charts-title">文章发布统计<span class="charts-sub">按月份 · 共 {monthTotal} 篇</span></h2>
    <div class="charts-bars">
      {
        monthSeries.map(([label, count]) => (
          <div class="charts-row">
            <span class="charts-label charts-label-month">{label}</span>
            <span class="charts-track">
              <span class="charts-fill" style={`width:${(count / maxMonth) * 100}%`} />
            </span>
            <span class="charts-count">{count}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="charts-block">
    <h2 class="charts-title">标签统计<span class="charts-sub">Top {topTags.length}</span></h2>
    <div class="charts-bars">
      {
        topTags.map(([label, count]) => (
          <div class="charts-row">
            <span class="charts-label" title={label}>{label}</span>
            <span class="charts-track">
              <span class="charts-fill charts-fill-alt" style={`width:${(count / maxTag) * 100}%`} />
            </span>
            <span class="charts-count">{count}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="charts-block">
    <h2 class="charts-title">分类统计</h2>
    <div class="charts-bars">
      {
        categorySeries.map(([label, count]) => (
          <div class="charts-row">
            <span class="charts-label" title={label}>{label}</span>
            <span class="charts-track">
              <span class="charts-fill charts-fill-cat" style={`width:${(count / maxCategory) * 100}%`} />
            </span>
            <span class="charts-count">{count}</span>
          </div>
        ))
      }
    </div>
  </section>
</div>

<script>
  /**
   * 访问数据：今日/昨日/本月/总访问量。
   *
   * busuanzi（vercount）只提供「累计 UV / 累计 PV」两个数，没有日/月维度，
   * 所以这里把累计值按天快照到 localStorage，用差值算出今日/昨日/本月：
   *   - 每天第一次打开：把上一次记录的累计值存为「昨日快照」
   *   - 今日 = 当前累计 − 昨日快照
   *   - 本月 = 当前累计 − 本月 1 号的快照
   * 因此这些数字从本功能上线起累计，不是历史回填（页脚小字已注明）。
   */
  const ENDPOINT = 'https://events.vercount.one/api/v2/log';
  const STORE = 'dsh:charts-visits:v1';

  interface Snapshot {
    lastDay: string;
    lastUv: number;
    lastPv: number;
    yesterdayUv: number;
    yesterdayPv: number;
    monthKey: string;
    monthStartPv: number;
  }

  interface VisitorData {
    site_uv?: number;
    site_pv?: number;
  }

  function todayKey(): string {
    const d = new Date();
    return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
  }

  function monthKey(): string {
    const d = new Date();
    return d.getFullYear() + '-' + (d.getMonth() + 1);
  }

  function load(): Snapshot | null {
    try {
      const raw = localStorage.getItem(STORE);
      return raw ? (JSON.parse(raw) as Snapshot) : null;
    } catch {
      return null;
    }
  }

  function save(snapshot: Snapshot): void {
    try {
      localStorage.setItem(STORE, JSON.stringify(snapshot));
    } catch {
      /* 隐私模式下可能不可写，忽略 */
    }
  }

  function paint(values: Record<string, number>): void {
    for (const [key, value] of Object.entries(values)) {
      const el = document.querySelector<HTMLElement>(`[data-site-stat="${key}"]`);
      if (el) el.textContent = value.toLocaleString('zh-CN');
    }
  }

  function boot(): void {
    const siteUrl = (
      document.querySelector<HTMLElement>('[data-site-url]')?.dataset.siteUrl ||
      'https://www.weisifengbuxi.top'
    ).replace(/\/+$/, '');

    const query = new URLSearchParams({
      url: (siteUrl + location.pathname).split(/[?#]/)[0],
      referrer: document.referrer || '',
      title: document.title,
    });

    fetch(ENDPOINT + "?" + query.toString())
      .then((r) => (r.ok ? r.json() : null))
      .then((payload: { data?: VisitorData } | null) => {
        const data = payload?.data;
        const uv = data?.site_uv;
        const pv = data?.site_pv;
        if (typeof uv !== 'number' || typeof pv !== 'number') return;

        const day = todayKey();
        const month = monthKey();
        const prev = load();

        let snapshot: Snapshot;
        if (!prev) {
          // 首次记录：今日/本月从 0 起算
          snapshot = {
            lastDay: day,
            lastUv: uv,
            lastPv: pv,
            yesterdayUv: 0,
            yesterdayPv: 0,
            monthKey: month,
            monthStartPv: pv,
          };
        } else {
          snapshot = { ...prev };
          if (prev.lastDay !== day) {
            // 跨天了：昨天 = 上次记录时的累计 − 更早的快照
            snapshot.yesterdayUv = Math.max(0, prev.lastUv - prev.yesterdayUv);
            snapshot.yesterdayPv = Math.max(0, prev.lastPv - prev.yesterdayPv);
            snapshot.lastDay = day;
          }
          if (prev.monthKey !== month) {
            snapshot.monthKey = month;
            snapshot.monthStartPv = prev.lastPv;
          }
          snapshot.lastUv = uv;
          snapshot.lastPv = pv;
        }
        save(snapshot);

        const baseUv = prev ? (snapshot.lastDay === day ? prev.yesterdayUv : snapshot.yesterdayUv) : 0;
        const basePv = prev ? (snapshot.lastDay === day ? prev.yesterdayPv : snapshot.yesterdayPv) : 0;

        paint({
          todayUv: Math.max(0, uv - baseUv),
          todayPv: Math.max(0, pv - basePv),
          yesterdayUv: snapshot.yesterdayUv,
          yesterdayPv: snapshot.yesterdayPv,
          monthPv: Math.max(0, pv - snapshot.monthStartPv),
          totalPv: pv,
        });
      })
      .catch(() => {
        /* 取数失败时保留占位符 */
      });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
  document.addEventListener('astro:page-load', boot);
</script>
<style>
    实时数据与「最后更新」排成同宽一排：VisitStats 自带 auto-fit 网格，
    这里用 :global 覆盖成 3 列，让最后一个格子与前面两张宽度一致。
  */
  .charts-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
.charts-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 1rem 0.5rem;
    border: 1px solid color-mix(in oklab, currentColor 12%, transparent);
    border-radius: 0.5rem;
  }

  .charts-stat-value {
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .charts-stat-label {
    font-size: 0.78rem;
    opacity: 0.7;
  }

  /* 总数：读起来比实时数字轻，标签在左、值在右，省纵向空间 */
  .charts-totals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.4rem 1.5rem;
  }

  .charts-total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0.15rem;
    border-bottom: 1px solid color-mix(in oklab, currentColor 8%, transparent);
  }

  .charts-total-label {
    font-size: 0.8rem;
    opacity: 0.7;
  }

  .charts-total-value {
    font-size: 0.95rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .charts-source {
    margin: 1rem 0 0;
    font-size: 0.72rem;
    opacity: 0.5;
  }

  .charts-block + .charts-block {
    margin-top: 2rem;
  }

  .charts-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 0.85rem;
  }

  .charts-sub {
    font-size: 0.75rem;
    font-weight: 400;
    opacity: 0.55;
  }

  .charts-bars {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .charts-row {
    display: grid;
    grid-template-columns: 7.5rem 1fr 2.25rem;
    align-items: center;
    gap: 0.6rem;
  }

  .charts-label {
    font-size: 0.8rem;
    opacity: 0.8;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .charts-label-month {
    font-variant-numeric: tabular-nums;
  }

  .charts-track {
    height: 0.85rem;
    border-radius: 9999px;
    background: color-mix(in oklab, currentColor 8%, transparent);
    overflow: hidden;
  }

  .charts-fill {
    display: block;
    height: 100%;
    min-width: 2px;
    border-radius: 9999px;
    background: linear-gradient(90deg, #e9546b, #ed788c);
    transition: width 0.6s ease;
  }

  .charts-fill-alt {
    background: linear-gradient(90deg, #6aa9e9, #8cc0f0);
  }

  .charts-fill-cat {
    background: linear-gradient(90deg, #6ec6a8, #9ad9c3);
  }

  .charts-count {
    font-size: 0.8rem;
    text-align: right;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .charts-row {
      grid-template-columns: 5rem 1fr 1.75rem;
      gap: 0.4rem;
    }
  }
</style>