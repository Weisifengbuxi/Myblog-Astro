---
import { essayItems, essaySubTitle, essayTips } from '@lib/pages';
/**
 * "即刻短文" — short posts on a timeline, newest first.
 */
import { Icon } from 'astro-icon/components';

const items = essayItems;

const formatDate = (value: string) => {
  const d = new Date(value.length <= 10 ? `${value}T00:00:00` : value);
  return Number.isNaN(d.getTime()) ? value : d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<div class="essay">
  <p class="essay-intro">
    <strong>{essaySubTitle}</strong>
    {essayTips && <span class="essay-tips"> · {essayTips}</span>}
  </p>

  <ol class="essay-timeline">
    {
      items.map((item) => (
        <li class="essay-item">
          <span class="essay-dot" aria-hidden="true" />
          <time class="essay-date" datetime={item.date}>
            {formatDate(item.date)}
          </time>
          <div class="essay-body">
            <p class="essay-content">{item.content}</p>

            {item.link && (
              <a class="essay-link" href={item.link} target="_blank" rel="noopener noreferrer">
                <Icon name="ri:link" /> 相关链接
              </a>
            )}

            {item.images && item.images.length > 0 && (
              <div class="essay-images">
                {item.images.map((src) => (
                  <a href={src} target="_blank" rel="noopener noreferrer" class="essay-image">
                    <img src={src} alt={item.content} loading="lazy" decoding="async" />
                  </a>
                ))}
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  {items.length === 0 && <p class="essay-empty">还没有短文。</p>}
</div>

<style>
  .essay-intro {
    opacity: 0.85;
    margin-bottom: 1.5rem;
  }

  .essay-tips {
    opacity: 0.7;
    font-size: 0.9rem;
  }

  .essay-empty {
    text-align: center;
    opacity: 0.6;
    padding: 2rem 0;
  }

  .essay-timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.25rem;
    position: relative;
  }

  .essay-timeline::before {
    content: '';
    position: absolute;
    top: 0.4rem;
    bottom: 0.4rem;
    left: 0.3rem;
    width: 1px;
    background: color-mix(in oklab, currentColor 18%, transparent);
  }

  .essay-item {
    position: relative;
    padding-bottom: 1.5rem;
  }

  .essay-item:last-child {
    padding-bottom: 0;
  }

  .essay-dot {
    position: absolute;
    left: -1.25rem;
    top: 0.42rem;
    width: 0.65rem;
    height: 0.65rem;
    margin-left: 0.02rem;
    border-radius: 9999px;
    background: #e9546b;
    box-shadow: 0 0 0 3px var(--background, #fff);
  }

  :global(html.dark) .essay-dot {
    box-shadow: 0 0 0 3px var(--background, #1c1c1e);
  }

  .essay-date {
    display: block;
    font-size: 0.75rem;
    opacity: 0.55;
    margin-bottom: 0.2rem;
  }

  .essay-content {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .essay-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: #e9546b;
    text-decoration: none;
  }

  .essay-link:hover {
    text-decoration: underline;
  }

  .essay-images {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .essay-image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.5rem;
    margin: 0;
  }
</style>
