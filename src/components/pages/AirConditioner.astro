---
/**
 * 便携小空调 — a self-contained "little air conditioner".
 *
 * The original Hexo page loaded a prebuilt Vue bundle from a third-party CDN
 * (npm.elemecdn.com/anzhiyu-air-conditioner), which is an external dependency
 * that can disappear and cannot be restyled. This is a from-scratch replacement:
 * no dependency, theme-aware colours, and it honours prefers-reduced-motion.
 *
 * 交互：
 *   - 温度 −/＋（16~30，长按可连续调节）
 *   - 开机 / 关机
 *   - 制冷 / 制热 切换（影响配色、风口动效方向与状态文案）
 *   - 按键音（Web Audio 合成，无音频文件），可静音；记忆在 localStorage
 *   - 键盘：面板聚焦后 ↑ ↓ 调温、M 切模式、P 开关机
 */
---

<div class="ac" data-ac>
  <p class="ac-hint">26 度是适宜温度哦~</p>

  <div class="ac-panel" data-ac-panel tabindex="0" role="group" aria-label="便携小空调">
    <div class="ac-screen">
      <span class="ac-temp" data-ac-temp>26</span>
      <span class="ac-unit">°C</span>
      <span class="ac-mode" data-ac-mode>制冷</span>
      <span class="ac-fan" data-ac-fan aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0" />
          <path d="M12 10c0-2 .5-4.5 2.5-5.5S18 6 16.5 8 12 10 12 10Z" />
          <path d="M14 12c2 0 4.5.5 5.5 2.5S18 18 16 16.5 14 12 14 12Z" />
          <path d="M12 14c0 2-.5 4.5-2.5 5.5S6 18 7.5 16 12 14 12 14Z" />
          <path d="M10 12c-2 0-4.5-.5-5.5-2.5S6 6 8 7.5 10 12 10 12Z" />
        </svg>
      </span>
    </div>

    <div class="ac-body" aria-hidden="true">
      <span class="ac-vent ac-vent-1"></span>
      <span class="ac-vent ac-vent-2"></span>
      <span class="ac-vent ac-vent-3"></span>
      <span class="ac-led" data-ac-led></span>
    </div>

    <div class="ac-controls">
      <button type="button" class="ac-btn" data-ac-down aria-label="降低温度">−</button>
      <button type="button" class="ac-btn ac-btn-power" data-ac-power aria-pressed="false">开机</button>
      <button type="button" class="ac-btn" data-ac-up aria-label="升高温度">＋</button>
    </div>

    <div class="ac-controls ac-controls-secondary">
      <button type="button" class="ac-btn ac-btn-mode" data-ac-modebtn aria-pressed="false">
        <span data-ac-modelabel>制热</span>
      </button>
      <button type="button" class="ac-btn ac-btn-sound" data-ac-sound aria-pressed="true" aria-label="按键音">
        <span data-ac-soundicon aria-hidden="true">🔊</span>
      </button>
    </div>

    <p class="ac-status" data-ac-status>已关机</p>
  </div>
</div>

<script>
  (() => {
    const root = document.querySelector<HTMLElement>('[data-ac]');
    if (!root) return;

    const MIN = 16;
    const MAX = 30;
    const SOUND_KEY = 'air-conditioner-sound';

    const tempEl = root.querySelector<HTMLElement>('[data-ac-temp]');
    const modeEl = root.querySelector<HTMLElement>('[data-ac-mode]');
    const statusEl = root.querySelector<HTMLElement>('[data-ac-status]');
    const powerBtn = root.querySelector<HTMLButtonElement>('[data-ac-power]');
    const upBtn = root.querySelector<HTMLButtonElement>('[data-ac-up]');
    const downBtn = root.querySelector<HTMLButtonElement>('[data-ac-down]');
    const modeBtn = root.querySelector<HTMLButtonElement>('[data-ac-modebtn]');
    const modeLabel = root.querySelector<HTMLElement>('[data-ac-modelabel]');
    const soundBtn = root.querySelector<HTMLButtonElement>('[data-ac-sound]');
    const soundIcon = root.querySelector<HTMLElement>('[data-ac-soundicon]');

    type Mode = 'cool' | 'heat';
    let on = false;
    let temp = 26;
    let mode: Mode = 'cool';

    // ---------------------------------------------------------------- sound
    // 用 Web Audio 合成，避免引入音频文件。首次用户交互时才创建 AudioContext，
    // 以符合浏览器的自动播放策略。
    let audioCtx: AudioContext | null = null;
    let soundOn = true;
    try {
      soundOn = localStorage.getItem(SOUND_KEY) !== 'false';
    } catch {
      /* localStorage 不可用时保持默认开启 */
    }

    const getCtx = (): AudioContext | null => {
      if (!soundOn) return null;
      try {
        if (!audioCtx) {
          const Ctor = window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
          if (!Ctor) return null;
          audioCtx = new Ctor();
        }
        if (audioCtx.state === 'suspended') void audioCtx.resume();
        return audioCtx;
      } catch {
        return null;
      }
    };

    /** 单个短促音符。 */
    const blip = (freq: number, duration = 0.07, type: OscillatorType = 'sine', gain = 0.06) => {
      const ctx = getCtx();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const amp = ctx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, ctx.currentTime);
      // 快速衰减包络，避免"咔"声
      amp.gain.setValueAtTime(0, ctx.currentTime);
      amp.gain.linearRampToValueAtTime(gain, ctx.currentTime + 0.008);
      amp.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
      osc.connect(amp).connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + duration + 0.02);
    };

    const sfx = {
      /** 清脆的「哔」，用于温度与模式按键 */
      tick: () => blip(880, 0.06, 'square', 0.035),
      /** 开机：上行两音 */
      powerOn: () => {
        blip(660, 0.09, 'sine', 0.06);
        window.setTimeout(() => blip(990, 0.14, 'sine', 0.06), 90);
      },
      /** 关机：下行两音 */
      powerOff: () => {
        blip(660, 0.09, 'sine', 0.05);
        window.setTimeout(() => blip(440, 0.16, 'sine', 0.05), 90);
      },
      /** 切模式：双音区分冷/热 */
      modeCool: () => blip(740, 0.1, 'triangle', 0.05),
      modeHeat: () => blip(520, 0.13, 'triangle', 0.055),
    };

    // ---------------------------------------------------------------- state
    // 制冷时温度越低越"强"，制热时温度越高越"强"。
    const intensityFor = (t: number): string => {
      if (mode === 'cool') return t <= 20 ? '强力制冷' : t <= 26 ? '制冷' : '送风';
      return t >= 28 ? '强力制热' : t >= 24 ? '制热' : '送风';
    };

    const render = () => {
      if (tempEl) tempEl.textContent = String(temp);
      if (modeEl) modeEl.textContent = mode === 'cool' ? '❄ 制冷' : '☀ 制热';
      if (modeLabel) modeLabel.textContent = mode === 'cool' ? '切制热' : '切制冷';
      root.classList.toggle('ac-on', on);
      root.classList.toggle('ac-heat', mode === 'heat');
      root.classList.toggle('ac-cool', mode === 'cool');
      if (statusEl) statusEl.textContent = on ? `运行中 · ${intensityFor(temp)}` : '已关机';
      if (powerBtn) {
        powerBtn.textContent = on ? '关机' : '开机';
        powerBtn.setAttribute('aria-pressed', String(on));
      }
      if (modeBtn) {
        modeBtn.setAttribute('aria-pressed', String(mode === 'heat'));
        modeBtn.disabled = !on;
      }
      if (upBtn) upBtn.disabled = !on || temp >= MAX;
      if (downBtn) downBtn.disabled = !on || temp <= MIN;
    };

    const setTemp = (next: number, playSound = true) => {
      const clamped = Math.min(MAX, Math.max(MIN, next));
      if (clamped === temp) return;
      temp = clamped;
      if (playSound) sfx.tick();
      render();
    };

    const setMode = (next: Mode, playSound = true) => {
      if (next === mode) return;
      mode = next;
      if (playSound) (mode === 'cool' ? sfx.modeCool : sfx.modeHeat)();
      render();
    };

    const setSound = (next: boolean, announce = true) => {
      soundOn = next;
      try {
        localStorage.setItem(SOUND_KEY, String(next));
      } catch {
        /* 忽略 */
      }
      if (soundBtn) soundBtn.setAttribute('aria-pressed', String(next));
      if (soundIcon) soundIcon.textContent = next ? '🔊' : '🔇';
      if (next && announce) sfx.tick();
    };

    // ---------------------------------------------------------------- events
    if (powerBtn) {
      powerBtn.addEventListener('click', () => {
        on = !on;
        (on ? sfx.powerOn : sfx.powerOff)();
        render();
      });
    }

    // 温度键：单击一步；按住 400ms 后连续调节
    const bindRepeat = (btn: HTMLButtonElement | null, delta: number) => {
      if (!btn) return;
      let holdTimer = 0;
      let repeatTimer = 0;

      const stop = () => {
        window.clearTimeout(holdTimer);
        window.clearInterval(repeatTimer);
      };

      btn.addEventListener('pointerdown', () => {
        if (btn.disabled) return;
        setTemp(temp + delta);
        holdTimer = window.setTimeout(() => {
          repeatTimer = window.setInterval(() => setTemp(temp + delta), 130);
        }, 400);
      });
      for (const event of ['pointerup', 'pointerleave', 'pointercancel'] as const) {
        btn.addEventListener(event, stop);
      }
      // 键盘可达性：Enter/Space 触发一次
      btn.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        setTemp(temp + delta);
      });
    };

    bindRepeat(upBtn, +1);
    bindRepeat(downBtn, -1);

    modeBtn?.addEventListener('click', () => setMode(mode === 'cool' ? 'heat' : 'cool'));

    soundBtn?.addEventListener('click', () => setSound(!soundOn));

    // 面板键盘快捷键
    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (on) setTemp(temp + 1);
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (on) setTemp(temp - 1);
      } else if (event.key === 'm' || event.key === 'M') {
        if (on) setMode(mode === 'cool' ? 'heat' : 'cool');
      } else if (event.key === 'p' || event.key === 'P') {
        on = !on;
        (on ? sfx.powerOn : sfx.powerOff)();
        render();
      }
    });

    setSound(soundOn, false);
    render();
  })();
</script>

<style>
  .ac {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
  }

  .ac-hint {
    opacity: 0.7;
    font-size: 0.9rem;
    margin: 0;
  }

  .ac-panel {
    width: min(100%, 22rem);
    border-radius: 1rem;
    padding: 1.25rem;
    background: linear-gradient(160deg, #cfd9e6, #aab8ca);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.6),
      0 6px 20px rgb(0 0 0 / 0.18);
    transition: background 0.5s ease;
    outline: none;
  }

  .ac-panel:focus-visible {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.6),
      0 6px 20px rgb(0 0 0 / 0.18),
      0 0 0 3px #e9546b;
  }

  :global(html.dark) .ac-panel {
    background: linear-gradient(160deg, #3a4150, #262b36);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 6px 20px rgb(0 0 0 / 0.45);
  }

  /* 制冷：冷色 */
  .ac-cool.ac-on .ac-panel {
    background: linear-gradient(160deg, #cfe6f5, #9fc9e8);
  }

  :global(html.dark) .ac-cool.ac-on .ac-panel {
    background: linear-gradient(160deg, #2f4a63, #1f3345);
  }

  /* 制热：暖色 */
  .ac-heat.ac-on .ac-panel {
    background: linear-gradient(160deg, #f7d9c4, #eeb08a);
  }

  :global(html.dark) .ac-heat.ac-on .ac-panel {
    background: linear-gradient(160deg, #5a3a2c, #3d251c);
  }

  .ac-screen {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.15rem;
    padding: 0.6rem;
    border-radius: 0.6rem;
    background: rgb(12 20 28 / 0.85);
    color: #7ee0a8;
    font-variant-numeric: tabular-nums;
    transition: color 0.4s ease;
  }

  .ac-cool.ac-on .ac-screen {
    color: #6ff0c0;
    text-shadow: 0 0 10px rgb(111 240 192 / 0.55);
  }

  .ac-heat.ac-on .ac-screen {
    color: #ffb072;
    text-shadow: 0 0 10px rgb(255 176 114 / 0.55);
  }

  .ac-temp {
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1;
  }

  .ac-unit {
    font-size: 1rem;
    opacity: 0.8;
  }

  .ac-mode {
    margin-left: 0.6rem;
    font-size: 0.8rem;
    opacity: 0.85;
    white-space: nowrap;
  }

  .ac-fan {
    margin-left: auto;
    width: 1.15rem;
    height: 1.15rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ac-fan svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ac-on .ac-fan {
    opacity: 0.9;
    animation: ac-spin 2.4s linear infinite;
  }

  .ac-heat .ac-fan {
    animation-direction: reverse;
  }

  @keyframes ac-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .ac-body {
    position: relative;
    height: 4.5rem;
    margin: 0.9rem 0;
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 0.35);
    overflow: hidden;
  }

  :global(html.dark) .ac-body {
    background: rgb(255 255 255 / 0.07);
  }

  .ac-vent {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: rgb(0 0 0 / 0.14);
    opacity: 0;
    transform: translateY(0);
  }

  :global(html.dark) .ac-vent {
    background: rgb(255 255 255 / 0.16);
  }

  .ac-vent-1 {
    top: 25%;
  }
  .ac-vent-2 {
    top: 50%;
  }
  .ac-vent-3 {
    top: 75%;
  }

  .ac-on .ac-vent {
    animation: ac-blow 1.6s linear infinite;
  }

  /* 制热时风向相反，呼应热风上浮 */
  .ac-heat .ac-vent {
    animation-direction: reverse;
  }

  .ac-on .ac-vent-2 {
    animation-delay: 0.25s;
  }
  .ac-on .ac-vent-3 {
    animation-delay: 0.5s;
  }

  @keyframes ac-blow {
    0% {
      opacity: 0;
      transform: translateX(-25%);
    }
    40% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translateX(25%);
    }
  }

  .ac-led {
    position: absolute;
    top: 0.6rem;
    right: 0.7rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: #7a8798;
    transition:
      background 0.4s ease,
      box-shadow 0.4s ease;
  }

  .ac-cool.ac-on .ac-led {
    background: #4ade80;
    box-shadow: 0 0 8px #4ade80;
  }

  .ac-heat.ac-on .ac-led {
    background: #fb923c;
    box-shadow: 0 0 8px #fb923c;
  }

  .ac-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .ac-controls-secondary {
    margin-top: 0.6rem;
  }

  .ac-btn {
    border: 0;
    cursor: pointer;
    border-radius: 0.6rem;
    font-size: 1.25rem;
    line-height: 1;
    min-width: 3rem;
    height: 2.75rem;
    padding: 0 0.6rem;
    color: #1f2937;
    background: rgb(255 255 255 / 0.85);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.12);
    transition:
      transform 0.15s ease,
      opacity 0.2s ease;
  }

  :global(html.dark) .ac-btn {
    color: #e5e7eb;
    background: rgb(255 255 255 / 0.12);
  }

  .ac-btn:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .ac-btn:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .ac-btn:focus-visible {
    outline: 2px solid #e9546b;
    outline-offset: 2px;
  }

  .ac-btn-power {
    font-size: 0.9rem;
    width: 5rem;
    font-weight: 600;
  }

  .ac-btn-mode {
    font-size: 0.85rem;
    font-weight: 600;
    min-width: 6rem;
  }

  .ac-btn-sound {
    font-size: 1rem;
    min-width: 3rem;
  }

  .ac-status {
    margin: 0.9rem 0 0;
    text-align: center;
    font-size: 0.8rem;
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .ac-on .ac-vent,
    .ac-on .ac-fan {
      animation: none;
      opacity: 0.5;
      transform: none;
    }
  }
</style>
