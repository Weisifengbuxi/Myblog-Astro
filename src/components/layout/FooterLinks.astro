---
/**
 * Footer navigation.
 *
 * Two shapes, mirroring the original Hexo/anzhiyu blog:
 *
 *  1. **Grouped** (`footerLinkGroups` in config/site.yaml) — several titled
 *     columns with the links stacked vertically, exactly like the original's
 *     `#anzhiyu-footer` / `.footer-group` markup.
 *  2. **Flat** (`footerLinks`) — the original single inline row of links
 *     separated by `·`, kept as a fallback when no groups are configured.
 *
 * The grouping exists because a 15-item flat row wraps awkwardly on narrow
 * screens, whereas columns stay readable.
 */
import { footerLinkGroups, footerLinks } from '@constants/site-config';
import { getLocaleFromUrl } from '@/i18n';

const locale = getLocaleFromUrl(Astro.url.pathname);

const grouped = footerLinkGroups;
const flat = footerLinks;
if (!grouped.length && !flat.length) return;

/** Prefix an internal path with the active locale when the site is multilingual. */
const href = (path: string) => {
  if (/^[a-z]+:|^\/\//i.test(path)) return path; // absolute URL
  if (locale === 'zh' || path.startsWith('/' + locale + '/')) return path;
  return path === '/' ? `/${locale}` : `/${locale}${path}`;
};

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (path: string) => path.replace(/\/$/, '') === current;
---

{
  grouped.length > 0 ? (
    <nav
      class="footer-groups"
      aria-label="页脚导航"
      style={`--footer-cols: ${Math.min(grouped.length, 4)}`}
    >
      {grouped.map((group) => (
        <div class="footer-group">
          <p class="footer-group-title">{group.title}</p>
          <ul class="footer-group-links">
            {group.links.map((item) => (
              <li>
                <a
                  href={href(item.path)}
                  class:list={['footer-link', { 'footer-link-active': isCurrent(item.path) }]}
                  aria-current={isCurrent(item.path) ? 'page' : undefined}
                >
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  ) : (
    <nav
      class="text-muted-foreground flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs"
      aria-label="页脚导航"
    >
      {flat.map((item, index) => (
        <>
          {index > 0 && (
            <span class="opacity-30" aria-hidden="true">
              ·
            </span>
          )}
          <a
            href={href(item.path)}
            class:list={['footer-link', { 'footer-link-active': isCurrent(item.path) }]}
            aria-current={isCurrent(item.path) ? 'page' : undefined}
          >
            {item.name}
          </a>
        </>
      ))}
    </nav>
  )
}

<style>
  /*
    多栏页脚，仿原博客 #anzhiyu-footer。

    用户反馈「四栏太集中、两侧留白很大」—— 原因是原先用
    `repeat(auto-fit, minmax(7rem, max-content))` + `justify-content: center`，
    每栏只占内容宽度（约 112px），四栏加起来才 450px 左右，在 1400px 的页脚里
    自然挤在中间。

    改为等分列（`repeat(N, minmax(0, 1fr))`）让各栏均分整行宽度，栏内文字居中，
    这样视觉上铺满整幅行宽，不再两侧空一大片。
  */
  .footer-groups {
    display: grid;
    grid-template-columns: repeat(var(--footer-cols, 4), minmax(0, 1fr));
    justify-content: stretch;
    gap: 1.5rem 2rem;
    width: 100%;
    font-size: 0.75rem;
  }

  .footer-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    align-items: center;
  }

  .footer-group-title {
    margin: 0;
    font-weight: 600;
    opacity: 0.9;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .footer-group-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  @media (992px >= width) {
    .footer-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem 1.5rem;
    }
  }
</style>
