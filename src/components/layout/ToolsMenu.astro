---
/**
 * Header utility-tools button.
 *
 * Ported from the original Hexo/anzhiyu blog, where `nav.pug` rendered a
 * gripper button (`.back-home-button`) at the top-left that opened a panel of
 * grouped external tools:
 *
 *   .back-home-button
 *     i.icon-grip-vertical
 *     .back-menu-list-groups
 *       .back-menu-list-group
 *         .back-menu-list-title= group.title
 *         .back-menu-list
 *           a.back-menu-item
 *             img.back-menu-item-icon
 *             span.back-menu-item-text
 *
 * Driven by `toolsMenu` in config/site.yaml; renders nothing when unset.
 * Hidden on mobile, where the drawer already carries the navigation.
 *
 * Interaction: opens on **hover** (`:hover` / `:focus-within`, no JS), matching
 * the original's hover panel rather than a click toggle.
 *
 * Icons are **local files** under `public/img/tools/`. Third-party favicon
 * services were tried first and abandoned: `favicon.im`, Google's `s2` service
 * and DuckDuckGo's icon endpoint were all unreachable from this network, so most
 * icons silently rendered blank for visitors on the same networks.
 */
import { toolsMenuGroups } from '@constants/site-config';
import { Icon } from 'astro-icon/components';

if (!toolsMenuGroups.length) return;
---

<div class="tools-menu tablet:hidden" data-tools-menu>
  {/*
    点击开合。状态放在 checkbox 里，纯 CSS 负责显隐 —— 这样按钮与面板都无需
    JS 参与，只有「点击外部 / Esc 关闭」需要一小段脚本。
    不加 title：原生 tooltip 会在面板展开时正好压住第一栏的分组标题
    （aria-label 已提供无障碍名称）。
  */}
  <input type="checkbox" id="tools-menu-toggle" class="tools-menu-toggle" aria-label="实用工具" />
  <label class="tools-menu-btn" for="tools-menu-toggle">
    <Icon name="ri:apps-2-line" class="size-5" />
  </label>

  <div class="tools-menu-panel" role="menu" aria-label="实用工具">
    {
      toolsMenuGroups.map((group) => (
        <div class="tools-menu-group">
          <p class="tools-menu-title">{group.title}</p>
          <div class="tools-menu-list">
            {group.items.map((item) => (
              <a
                class="tools-menu-item"
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                title={item.name}
              >
                {item.icon ? (
                  <img class="tools-menu-icon" src={item.icon} alt="" loading="lazy" decoding="async" />
                ) : (
                  <span class="tools-menu-icon tools-menu-icon-empty" aria-hidden="true">
                    {item.name.slice(0, 1)}
                  </span>
                )}
                <span class="tools-menu-text">{item.name}</span>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  /*
    点击开合。显隐完全由 checkbox 的 :checked 驱动（同层兄弟选择器），
    按钮与面板都不需要 JS；只有「点击外部 / Esc 关闭」用一小段脚本处理。
    checkbox 本身视觉隐藏但仍可聚焦，因此键盘可用（Tab → Space 切换）。
  */
  .tools-menu {
    position: relative;
    margin-right: 0.25rem;
  }

  .tools-menu-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .tools-menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: none;
    color: inherit;
    cursor: pointer;
    opacity: 0.85;
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease,
      rotate 0.3s ease;
  }

  .tools-menu-btn:hover,
  .tools-menu-toggle:checked + .tools-menu-btn {
    opacity: 1;
    background: rgb(255 255 255 / 0.2);
  }

  .tools-menu-toggle:checked + .tools-menu-btn {
    rotate: 90deg;
  }

  .tools-menu-toggle:focus-visible + .tools-menu-btn {
    outline: 2px solid rgb(255 255 255 / 0.8);
    outline-offset: 2px;
  }

  .tools-menu-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 60;
    display: flex;
    gap: 1.5rem;
    padding: 0.9rem 1.1rem;
    border-radius: 0.75rem;
    /* 主题的颜色变量是 HSL 分量（如 `--card: 0 12% 99%`），必须用 hsl() 包起来；
       直接写 var(--card) 会因值不合法而整条失效、面板变透明。 */
    background: hsl(var(--card, 0 0% 100%));
    color: hsl(var(--card-foreground, 340 12% 12%));
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.22);
    opacity: 0;
    visibility: hidden;
    translate: 0 -0.35rem;
    transition:
      opacity 0.2s ease,
      translate 0.2s ease,
      visibility 0.2s;
  }

  .tools-menu-toggle:checked ~ .tools-menu-panel {
    opacity: 1;
    visibility: visible;
    translate: 0;
  }

  .tools-menu-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 6.5rem;
  }

  .tools-menu-title {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 600;
    opacity: 0.55;
    letter-spacing: 0.04em;
  }

  .tools-menu-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .tools-menu-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.3rem;
    border-radius: 0.4rem;
    font-size: 0.8rem;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .tools-menu-item:hover {
    background: hsl(var(--primary) / 0.12);
    color: hsl(var(--primary));
  }

  .tools-menu-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    border-radius: 0.2rem;
    object-fit: contain;
  }

  /* 没有图标时显示名称首字，避免出现空白方块 */
  .tools-menu-icon-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 600;
    opacity: 0.65;
    background: hsl(var(--primary) / 0.14);
    color: hsl(var(--primary));
  }

  @media (prefers-reduced-motion: reduce) {
    .tools-menu-btn,
    .tools-menu-panel {
      transition: none;
    }

    .tools-menu-toggle:checked + .tools-menu-btn {
      rotate: none;
    }
  }
</style>

<script>
  /*
    点击开合由 checkbox + CSS 完成；这里只补两件 CSS 做不到的事：
    点击面板外部、以及按 Esc 时关闭。
    用事件委托挂在 document 上，且对「同一页重新注册」做了幂等处理 ——
    每次 ClientRouter 换页后 <script> 会重新执行一次。
  */
  const TOGGLE_ID = 'tools-menu-toggle';

  function closeOnOutsideClick(event: Event) {
    const toggle = document.getElementById(TOGGLE_ID) as HTMLInputElement | null;
    if (!toggle?.checked) return;

    const menu = toggle.closest('[data-tools-menu]');
    // 点击在菜单内（按钮或面板）交给 checkbox 自己切换，不在这里处理。
    if (menu && event.target instanceof Node && menu.contains(event.target)) return;
    toggle.checked = false;
  }

  function closeOnEscape(event: KeyboardEvent) {
    if (event.key !== 'Escape') return;
    const toggle = document.getElementById(TOGGLE_ID) as HTMLInputElement | null;
    if (!toggle?.checked) return;
    toggle.checked = false;
    // 焦点回到按钮，键盘用户可以继续操作。
    toggle.closest('[data-tools-menu]')?.querySelector('label')?.focus();
  }

  // `astro:page-load` fires on the initial load and after every ClientRouter
  // navigation, so bind once per document rather than once per script run.
  const bound = Symbol.for('tools-menu-outside-click');
  const doc = document as Document & { [bound]?: boolean };
  if (!doc[bound]) {
    doc[bound] = true;
    document.addEventListener('click', closeOnOutsideClick);
    document.addEventListener('keydown', closeOnEscape);
  }
</script>
