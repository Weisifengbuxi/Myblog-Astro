---
/**
 * 关于页专用布局 —— 与 `PageLayout` 的唯一区别是**不带左侧栏**。
 *
 * 旧博客的关于页是一整片卡片墙（作者信息、技能、生涯、地图……），塞进两栏布局后
 * 卡片会被挤成窄条，因此这里改用单列。其余（封面、评论区、标题）与 PageLayout 一致。
 */
import CustomContent from '@components/common/CustomContent.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { MAX_WIDTH } from '@constants/layout';
import { seoConfig } from '@constants/site-config';
import { Comment } from '@/components/comment';
import Layout from './Layout.astro';

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
    coverTitle?: string;
    comments?: boolean;
  };
}

const { frontmatter } = Astro.props;
const showComments = frontmatter.comments ?? true;
---

<Layout title={`${frontmatter.title} | ${seoConfig.title}`}>
  <div class={`mx-auto flex w-full max-w-full flex-col gap-8 ${MAX_WIDTH.content}`}>
    <Cover slot="cover" title={frontmatter.coverTitle ?? frontmatter.title} />
    <div class="prose dark:prose-invert w-full max-w-full" data-pagefind-body>
      <CustomContent>
        <slot />
      </CustomContent>
    </div>
    {showComments && <Comment />}
  </div>
</Layout>
