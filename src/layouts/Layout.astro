---
import type { HomeSiderType } from '@constants/enum';
import type { BlogPost } from 'types/blog';
import type { PageMeta, PageMetaProps } from './page-meta';

interface Props extends PageMetaProps {
  title?: string;
  description?: string;
  /**
   * Locale of the rendered page. Pages resolve it in `getStaticPaths` and pass it down;
   * callers that don't (e.g. Markdown pages rendered via `PageLayout`) fall back to the URL.
   */
  locale?: string;
  // TODO: siderType should be custom in router file, not in layout
  siderType?: HomeSiderType;
  /** Text-only indexes can skip article fullscreen viewers; media pages keep the default. */
  articleTools?: boolean;
  post?: BlogPost;
}

import { ClientRouter } from 'astro:transitions';
import La51Analytics from '@components/analytics/La51Analytics.astro';
import UmamiAnalytics from '@components/analytics/UmamiAnalytics.astro';
import { pageTransition } from '@constants/anim/page-transition';
import { seoConfig } from '@constants/site-config';
import LoadingIndicator from 'astro-loading-indicator/component';
import { Tooltips } from 'astro-tooltips';
import { getHtmlLang, getLocaleFromUrl, stripLocaleFromPath } from '@/i18n';
import AppShell from './AppShell.astro';
import BootScripts from './BootScripts.astro';
import HeadMeta from './HeadMeta.astro';

import '@styles/index.css';

const {
  title = seoConfig.title,
  description = seoConfig.description,
  locale = getLocaleFromUrl(Astro.url.pathname),
  siderType,
  articleTools = true,
  post,
  ...metaProps
} = Astro.props;

const meta: PageMeta = { ...metaProps, locale, title, description, coverImage: post?.data.cover };

// Detect if current page is a post page for mobile header (locale-prefix safe)
const isPostPage = stripLocaleFromPath(Astro.url.pathname).startsWith('/post/');
---

<!doctype html>
<html transition:name="root" transition:animate={pageTransition} lang={getHtmlLang(locale)}>
  <head>
    <!--
      让浏览器把页面里的 http:// 子资源自动升级成 https://。
      站点是纯 HTTPS，但头像这类资源来自别人家（友链 config、朋友圈定时抓取的
      public/fcircle/all.json），一旦漏进一个 http 链接，浏览器就会把整页标成
      「不安全」（混合内容警告）。代码侧已在渲染时用 toSecureUrl() 兜底，这里再
      加一层浏览器级的保险 —— 只升级、不阻断，http-only 的资源会加载失败而不是
      污染整个页面的安全状态。
    -->
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
    <HeadMeta meta={meta} />

    <ClientRouter />
    <UmamiAnalytics />
    <La51Analytics />
    <LoadingIndicator color="#e9536a" />
    <Tooltips interactive={false} />

    <BootScripts />

    <!-- 子页面可通过 slot="head" 注入额外的 head 内容（如 JSON-LD） -->
    <slot name="head" />
  </head>
  <body>
    <AppShell articleTools={articleTools} post={post} siderType={siderType} isPostPage={isPostPage}>
      <slot />
    </AppShell>
  </body>
</html>

<style is:global>
  /* 纪念日/哀悼日变灰（config/site.yaml -> mourn）
   * 类名由 BootScripts 在首屏前打到 <html> 上，且**只在首页**打。
   * 做成 CSS 而非内联 filter，是为了让 <html> 保持可被子元素样式覆盖，
   * 也避免污染滚动条等固定 UI。
   *   affect: 'cover' 首页整页去色（默认）；'page' 所有页面都整页去色 */
  html[data-mourn='cover'],
  html[data-mourn='page'] {
    filter: grayscale(1);
  }

  /* 只给头图去色的用法（如需）：html[data-mourn='cover'] .cover-hero { filter: grayscale(1); } */

  /* Progressive enhancement: scroll-state is experimental, browsers that don't support it will just not show the feather mask */
  @supports (container-type: scroll-state) {
    .scroll-feather-mask {
      container-type: scroll-state;
    }

  @container scroll-state(scrollable: bottom) {
      .scroll-feather-mask::after {
        content: '';
        background: linear-gradient(to bottom, transparent 0%, var(--gradient-bg-start) var(--mask-end-percent, 50%), var(--gradient-bg-start) var(--mask-start-percent, 100%));
        position: absolute;
        top: var(--mask-top, auto);
        left: var(--mask-left, 0);
        right: var(--mask-right, 0);
        bottom: var(--mask-bottom, 0);
        z-index: 10;
        display: block;
        height: var(--mask-height, 5rem);
      }
    }
  }
</style>
